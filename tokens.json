{
  "$description": "CD Week · tokens de identidad de la Computational Design Week (variación D1 · Perla). Formato de Design Tokens (W3C DTCG). Ver DESIGN.md.",
  "color": {
    "$type": "color",
    "neutro": {
      "perla": { "$value": "#F2F2F0", "$description": "Fondo de página" },
      "blanco": { "$value": "#FFFFFF", "$description": "Tarjetas, pastillas, trazos e íconos sobre color" },
      "niebla": { "$value": "#ECECEE", "$description": "Superficie secundaria, chips" },
      "fondo-hero": { "$value": "#ECECEA", "$description": "Detrás de los orbes del Hero" },
      "linea": { "$value": "#DEDEDA", "$description": "Divisores finos" },
      "fondo-lentes": { "$value": "#E3DFDD", "$description": "Fondo del mapa de lentes" },
      "grafito": { "$value": "#1D1E21", "$description": "Texto y botón primario" },
      "gris": { "$value": "#5E6166", "$description": "Texto secundario y etiquetas" }
    },
    "luz": {
      "$description": "Ordenados de cálido a frío. Siempre difusos y mezclados con sus vecinos; nunca como texto ni relleno plano.",
      "mantequilla": { "$value": "#F1E17C" },
      "durazno": { "$value": "#F8A082" },
      "coral": { "$value": "#F27751" },
      "rosa": { "$value": "#EE8FB4" },
      "lila": { "$value": "#B7A6EE" },
      "cielo": { "$value": "#85BBEF" },
      "cobalto": { "$value": "#3F6FE0" },
      "menta": { "$value": "#7FD6C2" },
      "violeta": { "$value": "#5B539B", "$description": "Solo lentes y enlaces" }
    },
    "texto": {
      "principal": { "$value": "{color.neutro.grafito}" },
      "secundario": { "$value": "{color.neutro.gris}" },
      "enlace": { "$value": "{color.luz.violeta}" },
      "foco": { "$value": "{color.luz.cobalto}" }
    }
  },
  "gradient": {
    "$type": "gradient",
    "firma": {
      "$description": "Degradado firma a 90°",
      "$value": [
        { "color": "{color.luz.mantequilla}", "position": 0 },
        { "color": "{color.luz.durazno}", "position": 0.143 },
        { "color": "{color.luz.coral}", "position": 0.286 },
        { "color": "{color.luz.rosa}", "position": 0.429 },
        { "color": "{color.luz.lila}", "position": 0.571 },
        { "color": "{color.luz.cielo}", "position": 0.714 },
        { "color": "{color.luz.cobalto}", "position": 0.857 },
        { "color": "{color.luz.menta}", "position": 1 }
      ]
    }
  },
  "campo": {
    "$description": "Tríos de color de las miniaturas de servicio (t1, t2, t3)",
    "territorio": { "$type": "color", "t1": { "$value": "{color.luz.coral}" }, "t2": { "$value": "{color.luz.durazno}" }, "t3": { "$value": "{color.luz.mantequilla}" } },
    "simulacion": { "$type": "color", "t1": { "$value": "{color.luz.rosa}" }, "t2": { "$value": "{color.luz.coral}" }, "t3": { "$value": "{color.luz.durazno}" } },
    "generativo": { "$type": "color", "t1": { "$value": "{color.luz.lila}" }, "t2": { "$value": "{color.luz.rosa}" }, "t3": { "$value": "{color.luz.durazno}" } },
    "automatizacion": { "$type": "color", "t1": { "$value": "{color.luz.cielo}" }, "t2": { "$value": "{color.luz.lila}" }, "t3": { "$value": "{color.luz.cobalto}" } },
    "educacion": { "$type": "color", "t1": { "$value": "{color.luz.cielo}" }, "t2": { "$value": "{color.luz.menta}" }, "t3": { "$value": "{color.luz.cobalto}" } }
  },
  "font": {
    "$type": "fontFamily",
    "display": { "$value": ["Inter Display", "Neue Haas Grotesk Display Pro", "Segoe UI Variable Display", "Segoe UI", "sans-serif"] },
    "texto": { "$value": ["Inter", "Segoe UI Variable Text", "Segoe UI", "sans-serif"] },
    "mono": { "$value": ["JetBrains Mono", "Cascadia Mono", "Consolas", "monospace"] },
    "acento": { "$value": ["Instrument Serif", "Sitka Display", "Georgia", "serif"], "$description": "Solo en itálica, una palabra por pastilla" }
  },
  "typography": {
    "$type": "typography",
    "titulo-hero": { "$value": { "fontFamily": "{font.display}", "fontWeight": 300, "fontSize": "56px", "lineHeight": 1.04, "letterSpacing": "-0.04em" } },
    "titulo-seccion": { "$value": { "fontFamily": "{font.display}", "fontWeight": 300, "fontSize": "38px", "lineHeight": 1, "letterSpacing": "-0.04em" } },
    "titulo-tarjeta": { "$value": { "fontFamily": "{font.display}", "fontWeight": 400, "fontSize": "22px", "lineHeight": 1.15, "letterSpacing": "-0.025em" } },
    "cifra": { "$value": { "fontFamily": "{font.display}", "fontWeight": 300, "fontSize": "84px", "lineHeight": 0.9, "letterSpacing": "-0.06em" } },
    "cuerpo": { "$value": { "fontFamily": "{font.texto}", "fontWeight": 400, "fontSize": "16px", "lineHeight": 1.55, "letterSpacing": "0" } },
    "pastilla": { "$value": { "fontFamily": "{font.texto}", "fontWeight": 600, "fontSize": "13.5px", "lineHeight": 1.2, "letterSpacing": "0" } },
    "boton": { "$value": { "fontFamily": "{font.texto}", "fontWeight": 500, "fontSize": "14px", "lineHeight": 1, "letterSpacing": "0" } },
    "etiqueta": { "$value": { "fontFamily": "{font.mono}", "fontWeight": 500, "fontSize": "11.5px", "lineHeight": 1.3, "letterSpacing": "0.16em" }, "$description": "En MAYÚSCULAS" }
  },
  "radius": {
    "$type": "dimension",
    "xl": { "$value": "28px", "$description": "Tarjetas, Hero, miniaturas, banner" },
    "lg": { "$value": "17px", "$description": "Lienzos de datos" },
    "md": { "$value": "16px", "$description": "Pastillas" },
    "sm": { "$value": "14px" },
    "full": { "$value": "999px", "$description": "Botones y chips" }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": "4px" }, "2": { "$value": "8px" }, "3": { "$value": "12px" }, "4": { "$value": "16px" }, "5": { "$value": "20px" },
    "6": { "$value": "28px" }, "7": { "$value": "40px" }, "8": { "$value": "56px" }, "9": { "$value": "80px" }, "10": { "$value": "104px" }
  },
  "orbe": {
    "$description": "Construcción del orbe: cónico de 4 colores, desenfoque, brillo y grano",
    "desenfoque": { "$type": "dimension", "$value": "6–8 % del diámetro" },
    "brillo": { "$type": "string", "$value": "radial-gradient(circle at 34% 30%, rgba(255,255,255,.78), transparent 46%)" },
    "grano": { "$type": "number", "$value": 0.45, "$description": "Opacidad del ruido en overlay (0.22 fondos, 0.3 campos, 0.4–0.5 orbes)" },
    "giro": { "$type": "duration", "$value": "48s", "$description": "40–70 s por vuelta" },
    "flotacion": { "$type": "duration", "$value": "18s", "$description": "16–22 s, 8–14 px" }
  }
}
